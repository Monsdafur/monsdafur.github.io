
---
const { title = "Monsdafur" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <div id="container">
      <header>
        <h1><a href="/">Monsdafur</a></h1>
        <nav>
          <a href="/about">about</a>
        </nav>
      </header>

      <hr />

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background-color: #252525;
    color: #ffffff;
    font-family: Inter, Roboto, 'Helvetica Neue',
      'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
  }

  body {
    min-height: 100vh;
  }

  #container {
    min-height: 100vh;
    max-width: 1150px;
    margin: 0 auto;
    padding: 24px;
    background-color: #252525;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
  }

  h1 a {
    color: #ffffff;
  }

  a {
    color: #b0b0b0;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  hr {
    border: none;
    border-top: 1px solid #555555;
    margin: 20px 0;
  }

  main {
    padding-top: 12px;
  }
</style>
